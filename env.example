# Render sets PORT automatically. Do not commit real values.
APP_HOST=0.0.0.0
META_GRAPH_VERSION=v23.0

# Required only when using WhatsApp Cloud API webhook.
# Use a long random value and enter the same value in Meta Webhooks.
META_VERIFY_TOKEN=replace-with-a-long-random-value

# Required only for official Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
